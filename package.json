{
  "name": "qaas-vscode",
  "displayName": "Quantum-as-a-Service (QHEAppE)",
  "description": "Run OpenQASM 3 and Qiskit circuits on the quantum computers available to your LEXIS project, through LEXIS and HEAppE: job manager, result downloads, billed-time estimates. AI tools were used to help implement this extension.",
  "version": "0.1.0",
  "publisher": "quantum-as-a-service-vscode",
  "author": {
    "name": "IT4Innovations National Supercomputing Center, VSB - Technical University of Ostrava",
    "url": "https://www.it4i.cz"
  },
  "contributors": [
    {
      "name": "Ing. Jan Swiatkowski"
    },
    {
      "name": "Ing. Jan Martinovič, Ph.D."
    }
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/It4innovations/quantum-as-a-service-vscode.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "quantum",
    "qiskit",
    "IQM",
    "QPU",
    "LEXIS",
    "HEAppE",
    "QHEAppE"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "QaaS runs the workspace's Python interpreter and sends your LEXIS token to the LEXIS instance the workspace configures."
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "qaas",
          "title": "Quantum (QaaS)",
          "icon": "media/qaas.svg"
        }
      ]
    },
    "views": {
      "qaas": [
        {
          "id": "qaas.jobs",
          "name": "Jobs"
        },
        {
          "id": "qaas.calibrations",
          "name": "Calibrations"
        },
        {
          "id": "qaas.operators",
          "name": "Pulse Operators"
        },
        {
          "id": "qaas.estimator",
          "name": "Billing Estimator",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "qaas.operators",
        "contents": "No pulse-level operators yet.\n[New Operator](command:qaas.operators.new)\nAn operator is a custom prx pulse (waveform + calibration per qubit and calibration set), stored in .qaas/operators/*.yaml next to your code."
      },
      {
        "view": "qaas.jobs",
        "contents": "No jobs yet. Synchronize to sign in to the LEXIS Platform and import your jobs from HEAppE.\n[$(sync) Synchronize with LEXIS Platform](command:qaas.sync)\nSign in with the browser or a refresh/access token. [Sign in to LEXIS…](command:qaas.signIn)\nOr run an OpenQASM file: [New OpenQASM 3 File](command:qaas.newQasmFile)",
        "when": "qaas.authMode != workflows"
      },
      {
        "view": "qaas.jobs",
        "contents": "No jobs yet. QaaS uses your IT4I Workflows sign-in. Synchronize to import your jobs from HEAppE.\n[$(sync) Synchronize with LEXIS Platform](command:qaas.sync)\nOr run an OpenQASM file: [New OpenQASM 3 File](command:qaas.newQasmFile)",
        "when": "qaas.authMode == workflows"
      },
      {
        "view": "qaas.calibrations",
        "contents": "Calibration sets of the current backend appear here: the current one, and those used by your jobs and operators.\n[$(refresh) Fetch Current Calibration Set](command:qaas.calibrations.refresh)\n[Open Calibration Set by ID…](command:qaas.calibrations.add)"
      }
    ],
    "languages": [
      {
        "id": "openqasm",
        "aliases": [
          "OpenQASM",
          "qasm"
        ],
        "extensions": [
          ".qasm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "openqasm",
        "scopeName": "source.openqasm",
        "path": "./syntaxes/openqasm.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "qaas.checkEnvironment",
        "title": "Check qaas Environment",
        "category": "QaaS"
      },
      {
        "command": "qaas.selectInterpreter",
        "title": "Select Python Interpreter",
        "category": "QaaS"
      },
      {
        "command": "qaas.createEnvironment",
        "title": "Create Python Environment for qaas",
        "category": "QaaS"
      },
      {
        "command": "qaas.installPackage",
        "title": "Install or Upgrade qaas",
        "category": "QaaS"
      },
      {
        "command": "qaas.restartBridge",
        "title": "Restart Python Bridge",
        "category": "QaaS"
      },
      {
        "command": "qaas.sync",
        "title": "Synchronize with LEXIS Platform",
        "category": "QaaS",
        "icon": "$(sync)"
      },
      {
        "command": "qaas.signIn",
        "title": "Sign in to LEXIS…",
        "category": "QaaS",
        "icon": "$(account)"
      },
      {
        "command": "qaas.setToken",
        "title": "Set LEXIS Token (Refresh or Access)",
        "category": "QaaS"
      },
      {
        "command": "qaas.testConnection",
        "title": "Test LEXIS Connection",
        "category": "QaaS",
        "icon": "$(plug)"
      },
      {
        "command": "qaas.openDevConnection",
        "title": "Open Dev Connection File (Test LEXIS Instance)",
        "category": "QaaS"
      },
      {
        "command": "qaas.clearToken",
