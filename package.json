    "menus": {
      "commandPalette": [
        {
          "command": "qaas.jobs.showResults",
          "when": "false"
        },
        {
          "command": "qaas.jobs.download",
          "when": "false"
        },
        {
          "command": "qaas.jobs.downloadTo",
          "when": "false"
        },
        {
          "command": "qaas.jobs.openFolder",
          "when": "false"
        },
        {
          "command": "qaas.jobs.cancel",
          "when": "false"
        },
        {
          "command": "qaas.jobs.copyId",
          "when": "false"
        },
        {
          "command": "qaas.jobs.remove",
          "when": "false"
        },
        {
          "command": "qaas.jobs.openDataWrangler",
          "when": "false"
        },
        {
          "command": "qaas.jobs.openNotebook",
          "when": "false"
        },
        {
          "command": "qaas.operators.openEditor",
          "when": "false"
        },
        {
          "command": "qaas.operators.openFile",
          "when": "false"
        },
        {
          "command": "qaas.operators.seed",
          "when": "false"
        },
        {
          "command": "qaas.operators.migrate",
          "when": "false"
        },
        {
          "command": "qaas.operators.markCalibrated",
          "when": "false"
        },
        {
          "command": "qaas.operators.deleteEntry",
          "when": "false"
        },
        {
          "command": "qaas.operators.insertCode",
          "when": "false"
        },
        {
          "command": "qaas.operators.calibrate",
          "when": "false"
        },
        {
          "command": "qaas.runQasmWithOperator",
          "when": "resourceLangId == openqasm || resourceExtname == .qasm"
        },
        {
          "command": "qaas.calibrations.open",
          "when": "false"
        },
        {
          "command": "qaas.calibrations.copyId",
          "when": "false"
        },
        {
          "command": "qaas.calibrations.export",
          "when": "false"
        },
        {
          "command": "qaas.calibrations.reload",
          "when": "false"
        },
        {
          "command": "qaas.jobs.clearForeign",
          "when": "false"
        }
      ],
      "editor/title/run": [
        {
          "command": "qaas.runCurrentFile",
          "when": "resourceLangId == python"
        },
        {
          "command": "qaas.runQasm",
          "when": "resourceLangId == openqasm || resourceExtname == .qasm"
        },
        {
          "command": "qaas.runQasmWithOperator",
          "when": "resourceLangId == openqasm || resourceExtname == .qasm"
        }
      ],
      "editor/title": [
        {
          "command": "qaas.transpileQasm",
          "when": "resourceLangId == openqasm || resourceExtname == .qasm",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "qaas.runQasm",
          "when": "resourceExtname == .qasm",
          "group": "qaas"
        }
      ],
      "view/title": [
        {
          "command": "qaas.sync",
          "when": "view == qaas.jobs",
          "group": "navigation@0"
        },
        {
          "command": "qaas.jobs.refresh",
          "when": "view == qaas.jobs",
          "group": "navigation@1"
        },
        {
          "command": "qaas.jobs.import",
          "when": "view == qaas.jobs",
          "group": "navigation@2"
        },
        {
          "command": "qaas.jobs.clearFinished",
          "when": "view == qaas.jobs",
          "group": "navigation@3"
        },
        {
          "command": "qaas.operators.new",
          "when": "view == qaas.operators",
          "group": "navigation@1"
        },
        {
          "command": "qaas.operators.refreshCalibration",
          "when": "view == qaas.operators",
          "group": "navigation@2"
        },
        {
          "command": "qaas.testConnection",
          "when": "view == qaas.jobs",
          "group": "9_connection@1"
        },
        {
          "command": "qaas.openDevConnection",
          "when": "view == qaas.jobs",
          "group": "9_connection@2"
        },
        {
          "command": "qaas.signIn",
          "when": "view == qaas.jobs",
          "group": "9_connection@0"
        },
        {
          "command": "qaas.calibrations.refresh",
          "when": "view == qaas.calibrations",
          "group": "navigation@1"
        },
        {
          "command": "qaas.calibrations.add",
          "when": "view == qaas.calibrations",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "qaas.jobs.showResults",
          "when": "view == qaas.jobs && viewItem =~ /\\bfinished\\b/",
          "group": "inline@1"
        },
        {
          "command": "qaas.jobs.download",
          "when": "view == qaas.jobs && viewItem =~ /\\bfinished\\b/",
          "group": "inline@2"
        },
        {
          "command": "qaas.jobs.cancel",
          "when": "view == qaas.jobs && viewItem =~ /\\bactive\\b/",
          "group": "inline@3"
        },
        {
          "command": "qaas.jobs.showResults",
          "when": "view == qaas.jobs && viewItem =~ /\\bfinished\\b/",
          "group": "1_results@1"
        },
        {
          "command": "qaas.jobs.download",
          "when": "view == qaas.jobs && viewItem =~ /\\bfinished\\b/",
          "group": "1_results@2"
        },
        {
          "command": "qaas.jobs.downloadTo",
          "when": "view == qaas.jobs && viewItem =~ /\\bfinished\\b/",
          "group": "1_results@3"
        },
        {
          "command": "qaas.jobs.openFolder",
          "when": "view == qaas.jobs && viewItem =~ /\\bdownloaded\\b/",
          "group": "1_results@4"
        },
        {
          "command": "qaas.jobs.cancel",
          "when": "view == qaas.jobs && viewItem =~ /\\bactive\\b/",
          "group": "2_manage@1"
        },
        {
          "command": "qaas.jobs.copyId",
          "when": "view == qaas.jobs && viewItem =~ /^job\\./",
          "group": "2_manage@2"
        },
        {
          "command": "qaas.jobs.remove",
          "when": "view == qaas.jobs && viewItem =~ /^job\\./",
          "group": "2_manage@3"
        },
        {
          "command": "qaas.jobs.openDataWrangler",
          "when": "view == qaas.jobs && viewItem =~ /\\bdownloaded\\b/",
          "group": "1_results@5"
        },
        {
          "command": "qaas.jobs.openNotebook",
          "when": "view == qaas.jobs && viewItem =~ /\\bdownloaded\\b/",
          "group": "1_results@6"
        },
        {
          "command": "qaas.operators.openEditor",
          "when": "view == qaas.operators && viewItem =~ /^operator\\./",
          "group": "inline@1"
        },
        {
          "command": "qaas.operators.migrate",
          "when": "view == qaas.operators && viewItem == operator.stale",
          "group": "inline@2"
        },
        {
          "command": "qaas.operators.openEditor",
          "when": "view == qaas.operators && viewItem =~ /^operator\\./",
          "group": "1_edit@1"
        },
        {
          "command": "qaas.operators.openFile",
          "when": "view == qaas.operators && viewItem =~ /^operator\\./",
          "group": "1_edit@2"
        },
        {
          "command": "qaas.operators.insertCode",
          "when": "view == qaas.operators && viewItem =~ /^operator\\./",
          "group": "2_use@1"
        },
        {
          "command": "qaas.operators.calibrate",
          "when": "view == qaas.operators && viewItem =~ /^operator\\./",
          "group": "2_use@2"
        },
        {
          "command": "qaas.operators.migrate",
          "when": "view == qaas.operators && viewItem == operator.stale",
          "group": "3_calibration@1"
        },
        {
          "command": "qaas.operators.seed",
          "when": "view == qaas.operators && viewItem =~ /^operator\\.(uncalibrated|stale|unknown)$/",
          "group": "3_calibration@2"
        },
        {
          "command": "qaas.operators.migrate",
          "when": "view == qaas.operators && viewItem =~ /^calibration\\.stale\\./",
          "group": "inline@1"
        },
        {
          "command": "qaas.operators.markCalibrated",
          "when": "view == qaas.operators && viewItem =~ /^calibration\\.(current|draft|unknown)\\.draft$/",
          "group": "inline@2"
        },
        {
          "command": "qaas.operators.migrate",
          "when": "view == qaas.operators && viewItem =~ /^calibration\\.stale\\./",
          "group": "1_calibration@1"
        },
        {
          "command": "qaas.operators.markCalibrated",
          "when": "view == qaas.operators && viewItem =~ /\\.draft$/",
          "group": "1_calibration@2"
        },
        {
          "command": "qaas.operators.insertCode",
          "when": "view == qaas.operators && viewItem =~ /^calibration\\./",
          "group": "2_use@1"
        },
        {
          "command": "qaas.operators.deleteEntry",
          "when": "view == qaas.operators && viewItem =~ /^calibration\\./",
          "group": "9_delete@1"
        },
        {
          "command": "qaas.calibrations.open",
          "when": "view == qaas.calibrations && viewItem =~ /^calset/",
          "group": "inline"
        },
        {
          "command": "qaas.calibrations.open",
          "when": "view == qaas.calibrations && viewItem =~ /^calset/",
          "group": "1_open@1"
        },
        {
          "command": "qaas.calibrations.export",
          "when": "view == qaas.calibrations && viewItem =~ /^calset/",
          "group": "2_export@1"
        },
        {
          "command": "qaas.calibrations.copyId",
          "when": "view == qaas.calibrations && viewItem =~ /^calset/",
          "group": "3_copy@1"
        },
        {
          "command": "qaas.calibrations.reload",
          "when": "view == qaas.calibrations && viewItem =~ /^calset/",
          "group": "4_reload@1"
        },
        {
          "command": "qaas.jobs.clearForeign",
          "when": "view == qaas.jobs && viewItem == jobGroupForeign",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Quantum-as-a-Service",
      "properties": {
        "qaas.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Python 3.12 interpreter with `qaas` (venv, conda or pyenv). Use **QaaS: Select Python Interpreter**. Empty uses the Python extension's selection, then `python3`."
        },
        "qaas.condaPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `conda` when it is not found automatically."
        },
        "qaas.packageExtra": {
          "type": "string",
          "enum": [
            "iqm_qiskit",
            "iqm36_qiskit",
            "iqm35_qiskit"
          ],
          "default": "iqm_qiskit",
          "description": "IQM extra installed with qaas (see the qaas compatibility table)."
        },
        "qaas.lexisProject": {
          "type": "string",
          "default": "",
          "description": "LEXIS project identifier."
        },
        "qaas.lexisResource": {
          "type": "string",
          "default": "",
          "description": "LEXIS resource name. Empty lets the client choose."
        },
        "qaas.backendName": {
          "type": "string",
          "default": "VLQ",
          "description": "Quantum backend name."
        },
        "qaas.lexisAaiUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "LEXIS authorization (Keycloak) URL. Empty uses production (`https://aai.lexis.tech`). `PY4LEXIS_AAI_URL` in the dev connection file takes precedence."
        },
        "qaas.lexisApiUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "LEXIS Platform API URL. Empty uses production (`https://api.lexis.tech`). `PY4LEXIS_API_URL` in the dev connection file takes precedence."
        },
        "qaas.lexisRealm": {
          "type": "string",
          "default": "",
          "markdownDescription": "Keycloak realm for the LEXIS login. Empty uses the py4lexis default (`LEXIS_AAI_v2`)."
        },
        "qaas.devConnectionFile": {
          "type": "string",
          "default": "${workspaceFolder}/.qaas/dev.env",
          "markdownDescription": "Developer connection file (dotenv). When it exists, its `PY4LEXIS_AAI_URL`, `PY4LEXIS_API_URL`, `PY4LEXIS_REALM`, `QAAS_LEXIS_PROJECT`, `QAAS_LEXIS_RESOURCE`, `QAAS_BACKEND_NAME` and `QAAS_LEXIS_TOKEN` override the settings and the stored token. Create it with **QaaS: Open Dev Connection File**."
        },
        "qaas.defaultShots": {
          "type": "integer",
          "default": 1024,
          "minimum": 1,
          "description": "Default shots when running OpenQASM files."
        },
        "qaas.confirmSubmit": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation, showing the billed-time estimate, before submitting."
        },
        "qaas.showEstimates": {
          "type": "boolean",
          "default": true,
          "description": "Show estimated VLQ billed time above job submissions in Python files, notebooks and .qasm files."
        },
        "qaas.validateQasm": {
          "type": "boolean",
          "default": true,
          "description": "Check OpenQASM 3 files with Qiskit's importer when they are opened or saved."
        },
        "qaas.jobPollSeconds": {
          "type": "integer",
          "default": 20,
          "minimum": 5,
          "description": "How often active jobs are refreshed."
        },
        "qaas.resultsDirectory": {
          "type": "string",
          "default": "${workspaceFolder}/qaas-results/${jobId}-${jobName}",
          "markdownDescription": "Where results are downloaded. Variables: `${workspaceFolder}`, `${userHome}`, `${jobId}`, `${jobName}`, `${project}`, `${date}`; `~` works too."
        },
        "qaas.downloadMeasurements": {
          "type": "boolean",
          "default": false,
          "description": "Also download per-shot measurements (larger files)."
        },
        "qaas.autoDownloadResults": {
          "type": "boolean",
          "default": false,
          "description": "Download results automatically when a job finishes."
        },
        "qaas.importJobLimit": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "description": "Maximum number of jobs fetched by Import Jobs from HEAppE."
        },
        "qaas.pulseSampleRate": {
          "type": "number",
          "default": 2000000000,
          "description": "Drive sample rate (samples/s) for waveform previews until the calibration set has been fetched."
        },
        "qaas.calibrationMaxAgeMinutes": {
          "type": "integer",
          "default": 60,
          "minimum": 1,
          "description": "Pulse-level runs re-read the current calibration set when the cached one is older than this."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "qaas",
        "properties": {
          "task": {
            "type": "string"
          }
        }
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": "**/.qaas/operators/*.yaml",
        "url": "./schemas/qaas-operator.schema.json"
      },
      {
        "fileMatch": "**/.qaas/operators/*.yml",
        "url": "./schemas/qaas-operator.schema.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "**/.qaas/operators/*.json",
        "url": "./schemas/qaas-operator.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "format": "biome format --write . && ruff format .",
    "lint": "biome check . && ruff check . && ruff format --check .",
    "lint:fix": "biome check --write . && ruff check --fix . && ruff format .",
    "test:unit": "npm run compile && node --test out/test/unit/*.test.js",
    "pretest": "npm run compile",
    "test": "vscode-test",
    "package": "vsce package",
    "test:py": "python -m unittest discover -s python/tests"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "yaml": "2.8.1",
    "yarn": "^1.22.22"
  }
}
