        "category": "QaaS",
        "icon": "$(verified)"
      },
      {
        "command": "qaas.operators.deleteEntry",
        "title": "Delete Calibration Entry",
        "category": "QaaS"
      },
      {
        "command": "qaas.operators.insertCode",
        "title": "Insert Python Code for Operator",
        "category": "QaaS",
        "icon": "$(code)"
      },
      {
        "command": "qaas.operators.calibrate",
        "title": "Calibrate with Rabi Notebook…",
        "category": "QaaS",
        "icon": "$(beaker)"
      },
      {
        "command": "qaas.calibrations.refresh",
        "title": "Fetch Current Calibration Set",
        "category": "QaaS",
